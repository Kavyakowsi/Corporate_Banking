<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================
         PROJECT
         ================================================================ -->

    <groupId>com.example</groupId>
    <artifactId>corporate-banking-demo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>corporate-banking-demo</name>
    <description>
        Corporate Banking demonstration app - consumes rbc-access and audit-trail
        as Maven dependencies
    </description>

    <!-- ================================================================
         SPRING BOOT
         ================================================================ -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <!-- ================================================================
         JAVA
         ================================================================ -->

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <playwright.version>1.62.0</playwright.version>
        <junit.version>5.13.4</junit.version>
    </properties>

    <!-- ================================================================
         DEPENDENCIES
         ================================================================ -->

    <dependencies>

        <!-- ============================================================
             RBC ACCESS LIBRARY
             ============================================================ -->

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>rbc-access</artifactId>
            <version>1.0.0</version>
        </dependency>


            <!-- Playwright -->
            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>${playwright.version}</version>
            </dependency>

            <!-- JUnit 5 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>

        <!-- ============================================================
             AUDIT TRAIL LIBRARY
             ============================================================ -->

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>audit-trail</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- ============================================================
             SPRING WEB
             ============================================================ -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============================================================
             SPRING DATA JPA
             ============================================================ -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ============================================================
             VALIDATION
             ============================================================ -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================================
             MYSQL
             ============================================================ -->

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================
             LOMBOK
             ============================================================ -->

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============================================================
             TEST
             ============================================================ -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ================================================================
         BUILD
         ================================================================ -->

    <build>

        <finalName>corporate-banking-demo</finalName>

        <plugins>

            <!-- ========================================================
                 MAVEN COMPILER
                 ======================================================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>

                <configuration>
                    <source>17</source>
                    <target>17</target>

                    <annotationProcessorPaths>

                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.34</version>
                        </path>

                    </annotationProcessorPaths>

                </configuration>

            </plugin>

            <!-- ========================================================
                 SPRING BOOT
                 ======================================================== -->

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>

    </build>

</project>